---
import BaseLayout from '../layouts/BaseLayout.astro';

const props = {
  title: "Our Team | Woodwolf Digital",
  description: "Meet the Woodwolf Digital team behind its design, development and marketing work.",
  path: "/team/",
  bodyClass: "body-wrapper body-page-inner font-heading-sequelsans-romanbody",
  ogImage: "/assets/imgs/team/team-11.webp",
  breadcrumbLabel: 'Our Team',
  variant: 'inner',
};
---
<BaseLayout {...props}>
<!-- side toggle end -->

  <!-- Header area start -->
  
  <!-- Header area end -->

  
  
    

      

        <!-- page title area start  -->
        <section class="page-title-area">
          <div class="container large">
            <div class="page-title-area-inner section-spacing-top">
              <div class="page-title-wrapper">
                <h1 class="page-title fade-anim">Our Team</h1>
              </div>
            </div>
          </div>
        </section>
        <!-- page title area end  -->

        <!-- team area start  -->
        <section class="team-area-team-page">
          <div class="team-area-team-page-inner">
            <div class="container large">
              <div class="section-header fade-anim">
                <div class="section-title-wrapper">
                  <div class="team-info">
                    <div class="team-group">
                      <img src="/assets/imgs/team/team-11.webp" alt="image">
                      <img src="/assets/imgs/team/team-12.webp" alt="image" loading="lazy">
                      <img src="/assets/imgs/team/team-13.webp" alt="image" loading="lazy">
                    </div>
                    <div class="text-wrapper">
                      <p class="text">A team of <span>80+</span> skilled employees
                        is working behind your creative
                        works</p>
                    </div>
                  </div>
                  <div class="title-wrapper">
                    <h2 class="section-title font-sequelsans-romanbody">Our talented
                      squad</h2>
                    <p class="text">We’re a diverse team that works as fancies attention to details, enjoys beers on
                      Friday nights and aspires to design the dent in the universe.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <!-- team area end  -->

        <!-- team area start  -->
        <section class="team-area">
          <div class="container large">
            <div class="team-area-inner">
              <div class="team-wrapper-box fade-anim">
                <div class="team-wrapper">
                  <div class="team-box">
                    <div class="thumb">
                      <a href="/team-details/"><img src="/assets/imgs/team/team-1.webp" alt="image" loading="lazy"></a>
                    </div>
                    <div class="content">
                      <h3 class="name"><a href="/team-details/">James David</a></h3>
                      <span class="post">CEO & Founder</span>
                    </div>
                  </div>
                  <div class="team-box">
                    <div class="thumb">
                      <a href="/team-details/"><img src="/assets/imgs/team/team-2.webp" alt="image" loading="lazy"></a>
                    </div>
                    <div class="content">
                      <h3 class="name"><a href="/team-details/">Brenda C. Janet</a></h3>
                      <span class="post">Lead Developer</span>
                    </div>
                  </div>
                  <div class="team-box">
                    <div class="thumb">
                      <a href="/team-details/"><img src="/assets/imgs/team/team-3.webp" alt="image" loading="lazy"></a>
                    </div>
                    <div class="content">
                      <h3 class="name"><a href="/team-details/">Martin Carlos</a></h3>
                      <span class="post">Lead Designer</span>
                    </div>
                  </div>
                  <div class="team-box">
                    <div class="thumb">
                      <a href="/team-details/"><img src="/assets/imgs/team/team-4.webp" alt="image" loading="lazy"></a>
                    </div>
                    <div class="content">
                      <h3 class="name"><a href="/team-details/">Garry J. Coburn</a></h3>
                      <span class="post">Project Manager</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <!-- team area end  -->

        <!-- team list area start  -->
        <div class="team-list-area">
          <div class="container large">
            <div class="team-list-area-inner">
              <div class="team-wrapper-box fade-anim">
                <div class="team-wrapper">
                  <div class="team-box">
                    <div class="thumb">
                      <a href="/team-details/"><img src="/assets/imgs/team/team-5.webp" alt="image" loading="lazy"></a>
                    </div>
                    <div class="content">
                      <h3 class="name"><a href="/team-details/">Ana Dina Belić</a></h3>
                    </div>
                    <span class="post">Graphic Designer</span>
                    <a href="/team-details/" class="t-btn t-btn-normal"><img src="/assets/imgs/icon/icon-5.webp"
                        alt="image" loading="lazy"></a>
                  </div>
                  <div class="team-box">
                    <div class="thumb">
                      <a href="/team-details/"><img src="/assets/imgs/team/team-6.webp" alt="image" loading="lazy"></a>
                    </div>
                    <div class="content">
                      <h3 class="name"><a href="/team-details/">Giuseppe Carbonara</a></h3>
                    </div>
                    <span class="post">Brand Strategist</span>
                    <a href="/team-details/" class="t-btn t-btn-normal"><img src="/assets/imgs/icon/icon-5.webp"
                        alt="image" loading="lazy"></a>
                  </div>
                  <div class="team-box">
                    <div class="thumb">
                      <a href="/team-details/"><img src="/assets/imgs/team/team-7.webp" alt="image" loading="lazy"></a>
                    </div>
                    <div class="content">
                      <h3 class="name"><a href="/team-details/">Vedran Starčić</a></h3>
                    </div>
                    <span class="post">Jr. Designer</span>
                    <a href="/team-details/" class="t-btn t-btn-normal"><img src="/assets/imgs/icon/icon-5.webp"
                        alt="image" loading="lazy"></a>
                  </div>
                  <div class="team-box">
                    <div class="thumb">
                      <a href="/team-details/"><img src="/assets/imgs/team/team-8.webp" alt="image" loading="lazy"></a>
                    </div>
                    <div class="content">
                      <h3 class="name"><a href="/team-details/">Izquierdo Bayà</a></h3>
                    </div>
                    <span class="post">Creative Writer </span>
                    <a href="/team-details/" class="t-btn t-btn-normal"><img src="/assets/imgs/icon/icon-5.webp"
                        alt="image" loading="lazy"></a>
                  </div>
                  <div class="team-box">
                    <div class="thumb">
                      <a href="/team-details/"><img src="/assets/imgs/team/team-9.webp" alt="image" loading="lazy"></a>
                    </div>
                    <div class="content">
                      <h3 class="name"><a href="/team-details/">Jared Silverman</a></h3>
                    </div>
                    <span class="post">Motion Designer</span>
                    <a href="/team-details/" class="t-btn t-btn-normal"><img src="/assets/imgs/icon/icon-5.webp"
                        alt="image" loading="lazy"></a>
                  </div>
                  <div class="team-box">
                    <div class="thumb">
                      <a href="/team-details/"><img src="/assets/imgs/team/team-10.webp" alt="image" loading="lazy"></a>
                    </div>
                    <div class="content">
                      <h3 class="name"><a href="/team-details/">Samuel Bertain</a></h3>
                    </div>
                    <span class="post">WordPress Developer</span>
                    <a href="/team-details/" class="t-btn t-btn-normal"><img src="/assets/imgs/icon/icon-5.webp"
                        alt="image" loading="lazy"></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- team list area end  -->

        <!-- cta area start  -->
        <section class="cta-area-team-page">
          <div class="container large">
            <div class="cta-area-team-page-inner section-spacing-top">
              <div class="section-content fade-anim">
                <div class="section-title-wrapper">
                  <div class="title-wrapper">
                    <h2 class="section-title font-sequelsans-romanbody">We think out of the box when it comes
                      to strategy, design and creative. Want to join
                      the talented team?</h2>
                  </div>
                </div>
                <div class="btn-wrapper">
                  <a href="/contact/" class="rr-btn">
                    <span class="btn-wrap">
                      <span class="text-one">Send Us Now</span>
                      <span class="text-two">Send Us Now</span>
                    </span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
        <!-- cta area end  -->

      

      <!-- footer area start  -->
      
      <!-- footer area end  -->

    </div>
  </div>
</BaseLayout>
