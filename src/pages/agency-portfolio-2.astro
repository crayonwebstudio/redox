---
import VariantLayout from '../layouts/VariantLayout.astro';
import headerHtml from '../data/variants/agency-portfolio-2-header.html?raw';
import sideInfoHtml from '../data/variants/agency-portfolio-2-sideinfo.html?raw';
import footerHtml from '../data/variants/agency-portfolio-2-footer.html?raw';

const props = {
  title: "Agency Portfolio 2 | Woodwolf Digital",
  description: "Explore Woodwolf Digital's agency portfolio 2 homepage: creative design, development and marketing services, portfolio work and team.",
  path: "/agency-portfolio-2/",
  bodyClass: "body-wrapper body-about-us",
  cssFiles: ["/assets/css/ad-style.css"],
  scriptFiles: ["/assets/vendor/jquery-3.7.1.min.js", "/assets/vendor/bootstrap.bundle.min.js", "/assets/vendor/jquery.magnific-popup.min.js", "/assets/vendor/swiper.min.js", "/assets/vendor/gsap.min.js", "/assets/vendor/ScrollTrigger.min.js", "/assets/vendor/ScrollSmoother.min.js", "/assets/vendor/ScrollToPlugin.min.js", "/assets/vendor/SplitText.min.js", "/assets/vendor/TextPlugin.js", "/assets/vendor/customEase.js", "/assets/vendor/Flip.min.js", "/assets/vendor/jquery.meanmenu.min.js", "/assets/vendor/backToTop.js", "/assets/vendor/matter.js", "/assets/vendor/throwable.js", "/assets/ad-js/magiccursor.js", "/assets/vendor/waypoints.min.js", "/assets/ad-js/image-reveal-hover.js", "/assets/ad-js/main.js"],
  headerHtml,
  sideInfoHtml,
  footerHtml,
  noindex: true,
};
---
<VariantLayout {...props}>

    <!-- Header area end -->

    <!-- Header area end -->

    
    
        

            
                <section class="hero-area-10">
                    <div class="hero-area-10__inner">
                        <div class="container rr-container-1850">
                            <div class="hero-area-10__content">
                                <div class="hero-area-10__wrapper">
                                    <div class="sub-title-wrap">
                                        <h6 class="sub-title">Agency</h6>
                                    </div>
                                    <div class="text">
                                        <p> We are the first creative agency of passionate individuals who live and
                                            breathe design, fueled by the relentless pursuit of pushing boundaries and
                                            redefining what is possible.</p>

                                        <a class="btn-line" href="/about/">Learn more <i
                                                class="fa-classic fa-solid fa-arrow-right fa-fw"></i></a>
                                    </div>
                                </div>
                                <div class="hero-area-10-title-wrap">
                                    <div class="pulse"></div>
                                    <h1 class="title">port<span>folio</span></h1>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Projects-area-10 area start  -->
                <section class="Projects-area-10 section-spacing-bottom-200">
                    <div class="container rr-container-1850">
                        <div class="Projects-area-10-inner">
                            <div class="Projects__content">
                                <h6 class="name">Names</h6>
                                <ul>
                                    <li>La Caminera</li>
                                    <li>Ansorena</li>
                                    <li>Miramono</li>
                                    <li>Tastavents</li>
                                    <li>Maserati</li>
                                    <li>The Prado Museum</li>
                                    <li>Cupra</li>
                                    <li>Alicia Moore</li>
                                </ul>
                            </div>
                            <div class="Projects-wrapper">
                                <h6 class="title">Projects</h6>
                                <div class="Projects__item parallax-view">
                                    <a href="/portfolio-details/">
                                        <img data-speed="0.7" src="/assets/ad-imgs/project/project-r-22.webp" alt="">
                                    </a>
                                </div>
                                <div class="Projects__item parallax-view">
                                    <a href="/portfolio-details/">
                                        <img data-speed="0.7" src="/assets/ad-imgs/project/project-r-23.webp" alt="" loading="lazy">
                                    </a>
                                </div>
                                <div class="Projects__item parallax-view">
                                    <a href="/portfolio-details/">
                                        <img data-speed="0.7" src="/assets/ad-imgs/project/project-r-24.webp" alt="" loading="lazy">
                                    </a>
                                </div>
                                <div class="Projects__item parallax-view">
                                    <a href="/portfolio-details/">
                                        <img data-speed="0.7" src="/assets/ad-imgs/project/project-r-25.webp" alt="" loading="lazy">
                                    </a>
                                </div>
                                <div class="Projects__item parallax-view">
                                    <a href="/portfolio-details/">
                                        <img data-speed="0.7" src="/assets/ad-imgs/project/project-r-26.webp" alt="" loading="lazy">
                                    </a>
                                </div>
                                <div class="Projects__item parallax-view">
                                    <a href="/portfolio-details/">
                                        <img data-speed="0.7" src="/assets/ad-imgs/project/project-r-27.webp" alt="" loading="lazy">
                                    </a>
                                </div>
                                <div class="Projects__item parallax-view">
                                    <a href="/portfolio-details/">
                                        <img data-speed="0.7" src="/assets/ad-imgs/project/project-r-28.webp" alt="" loading="lazy">
                                    </a>
                                </div>
                                <div class="Projects__item parallax-view">
                                    <a href="/portfolio-details/">
                                        <img data-speed="0.7" src="/assets/ad-imgs/project/project-r-29.webp" alt="" loading="lazy">
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Projects-area-10 area start  -->

                <section class="service-10-area">
                    <div class="container rr-container-1850">
                        <div class="service-10__inner">
                            <div class="service-10-border section-spacing-bottom-200">
                                <div>
                                    <h6 class="sub-title">Capabilities</h6>
                                </div>
                                <div class="service-10__wrap">
                                    <div class="service-10__wrapper">
                                        <div class="active-bg"></div>
                                        <ul class="service-10-list">
                                            <li class="service-10__item ">
                                                <a href="/service-details/">
                                                    <div class="title">Art Direction</div>
                                                </a>

                                            </li>
                                            <li class="service-10__item">
                                                <a href="/service-details/">
                                                    <div class="title">Design</div>
                                                </a>
                                            </li>
                                            <li class="service-10__item">
                                                <a href="/service-details/">
                                                    <div class="title">Development </div>
                                                </a>
                                            </li>
                                            <li class="service-10__item">
                                                <a href="/service-details/">
                                                    <div class="title">Digital Marketing</div>
                                                </a>

                                            </li>
                                            <li class="service-10__item">
                                                <a href="/service-details/">
                                                    <div class="title">Motion Design</div>
                                                </a>

                                            </li>
                                            <li class="service-10__item">
                                                <a href="/service-details/">
                                                    <div class="title">Writing</div>
                                                </a>
                                            </li>
                                            <li class="service-10__item">
                                                <a href="/service-details/">
                                                    <div class="title">Brand Guidelines</div>
                                                </a>

                                            </li>
                                            <li class="service-10__item">
                                                <a href="/service-details/">
                                                    <div class="title">Strategy</div>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    <a class="btn-explore" href="/services/">Learn more service<i
                                            class="fa-classic fa-solid fa-arrow-right fa-fw"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="capabilities-area-10 section-spacing-top-200 section-spacing-bottom">
                    <div class="container rr-container-1850">
                        <div class="capabilities__inner">
                            <div class="section-5-title-wrapper">
                                <h6 class="sub-title">
                                    <span>Capabilities</span>
                                </h6>
                                <h2 class="title">Explore our portfolio to gain insights into our diverse projects,
                                    drawing
                                    inspiration for your own architectural aspirations.</h2>
                            </div>
                            <div class="capabilities__wrapper">
                                <div class="capabilities__media parallax-view">
                                    <img data-speed="0.7" src="/assets/ad-imgs/project/project-r-30.webp" alt="image" loading="lazy">
                                </div>
                                <div class="capabilities__content">
                                    <div class="media">
                                        <img src="/assets/ad-imgs/project/project-r-31.webp" alt="image" loading="lazy">
                                        <h3 class="number">140+</h3>
                                    </div>

                                    <div class="text">
                                        <h5 class="sub-title">We completed projects <br>
                                            last 17 years</h5>
                                        <p>We help local companies and services enter the market, and well-known brands
                                            expand an audience.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            
            <!-- footer area start  -->
            
</VariantLayout>
