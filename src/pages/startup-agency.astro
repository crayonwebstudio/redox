---
import VariantLayout from '../layouts/VariantLayout.astro';
import headerHtml from '../data/variants/startup-agency-header.html?raw';
import sideInfoHtml from '../data/variants/startup-agency-sideinfo.html?raw';
import footerHtml from '../data/variants/startup-agency-footer.html?raw';

const props = {
  title: "Startup Agency | Woodwolf Digital",
  description: "Explore Woodwolf Digital's startup agency homepage: creative design, development and marketing services, portfolio work and team.",
  path: "/startup-agency/",
  bodyClass: "body-wrapper body-startup-agency font-heading-bdogrotesk-regular",
  cssFiles: ["/assets/css/style.css"],
  scriptFiles: ["/assets/vendor/jquery-3.7.1.min.js", "/assets/vendor/bootstrap.bundle.min.js", "/assets/vendor/jquery.magnific-popup.min.js", "/assets/vendor/swiper-bundle.min.js", "/assets/vendor/gsap.min.js", "/assets/vendor/ScrollTrigger.min.js", "/assets/vendor/ScrollSmoother.min.js", "/assets/vendor/ScrollToPlugin.min.js", "/assets/vendor/SplitText.min.js", "/assets/vendor/TextPlugin.js", "/assets/vendor/customEase.js", "/assets/vendor/Flip.min.js", "/assets/vendor/jquery.meanmenu.min.js", "/assets/vendor/backToTop.js", "/assets/vendor/matter.js", "/assets/vendor/throwable.js", "/assets/js/magiccursor.js", "/assets/js/main.js"],
  headerHtml,
  sideInfoHtml,
  footerHtml,
  noindex: true,
};
---
<VariantLayout {...props}>

  <!-- Header area end -->

  
  
    

      

        <!-- hero area start  -->
        <section class="hero-area-5">
          <div class="container large">
            <div class="hero-area-5-inner section-spacing">
              <div class="section-content-wrapper">
                <div class="hero-video fade-anim" data-direction="left" data-delay="0.45" data-offset="100"
                  data-ease="back.out(3)">
                  <video class="title-video" loop muted autoplay playsinline>
                    <source src="https://rrdevs.net/project-video/xfire.webm" type="video/mp4">
                  </video>
                </div>
                <div class="section-content">
                  <div class="section-title-wrapper">
                    <div class="title-wrapper fade-anim">
                      <h1 class="section-title font-bdogrotesk-regular char-anim">Where visionary
                        concepts come
                        to life</h1>
                    </div>
                  </div>
                  <div class="text-btn-wrapper fade-anim" data-delay="0.60">
                    <div class="text-wrapper fade-anim" data-delay="0.75">
                      <p class="text">We’re a leading digital product agency focused on branding, UI/UX
                        design,
                        mobile,
                        and web development.</p>
                    </div>
                    <div class="btn-wrapper fade-anim" data-delay="0.90">
                      <a href="/contact/" class="rr-btn">
                        <span class="btn-wrap">
                          <span class="text-one">Send massage</span>
                          <span class="text-two">Send massage</span>
                        </span>
                      </a>
                    </div>
                  </div>
                </div>

              </div>
              <div class="hero-shape-1 section-spacing-top">
                <img class="fade-anim" data-direction="right" data-offset="100" data-delay="1.05"
                  src="/assets/imgs/shape/shape-19.webp" alt="image">
              </div>
            </div>
          </div>
        </section>
        <!-- hero area end  -->

        <!-- work area start  -->
        <section class="work-area-4">
