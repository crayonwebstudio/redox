---
import BaseLayout from '../layouts/BaseLayout.astro';

const props = {
  title: "Portfolio | Woodwolf Digital",
  description: "Browse selected Woodwolf Digital portfolio work across design, development and marketing projects.",
  path: "/portfolio/",
  bodyClass: "body-wrapper body-page-inner font-heading-sequelsans-romanbody",
  ogImage: "/assets/imgs/project/image-19.webp",
  breadcrumbLabel: 'Portfolio',
  variant: 'inner',
};
---
<BaseLayout {...props}>
<!-- side toggle end -->

  <!-- Header area start -->
  
  <!-- Header area end -->

  
  
    

      

        <!-- page title area start  -->
        <section class="page-title-area">
          <div class="container large">
            <div class="page-title-area-inner section-spacing-top">
              <div class="page-title-wrapper">
                <h1 class="page-title fade-anim">Portfolio</h1>
              </div>
            </div>
          </div>
        </section>
        <!-- page title area end  -->

        <!-- work area start  -->
        <section class="work-area-work-page">
          <div class="work-area-work-page-inner">
            <div class="container large">
              <div class="section-header fade-anim">
                <div class="section-title-wrapper">
                  <div class="subtitle-wrapper">
                    <span class="section-subtitle">Recent work</span>
                  </div>
                  <div class="title-wrapper">
                    <h2 class="section-title font-sequelsans-romanbody">Creative works
                      with our incredible
                      people.</h2>
                  </div>
                </div>
              </div>
              <div class="section-content-wrapper fade-anim">
                <div class="info-list">
                  <ul>
                    <li>design</li>
                    <li>Development</li>
                    <li>Marketing</li>
                    <li>Writing</li>
                  </ul>
                </div>
                <div class="section-content">
                  <div class="text-wrapper" data-direction="right">
                    <p class="text">We take a comprehensive approach to the creation and development of brands. We
                      help local companies and services enter the market, and well-known brands expand an audience.
                    </p>
                  </div>
                </div>
              </div>

            </div>
            <div class="works-wrapper-box">
              <div class="container large">
                <div class="works-wrapper-8">
                  <div class="work-box">
                    <div class="thumb">
                      <div class="image scale" data-cursor-text="View Project">
                        <a href="/portfolio-details/"><img src="/assets/imgs/project/image-19.webp" alt="image"></a>
                      </div>
                    </div>
                    <div class="content">
                      <h3 class="title"><a href="/portfolio-details/">Harash Denmark</a></h3>
                      <div class="meta">
                        <span class="date">2010</span>
                        <span class="tag">Branding</span>
                      </div>
                    </div>
                  </div>
                  <div class="work-box">
                    <div class="thumb">
                      <div class="image scale" data-cursor-text="View Project">
                        <a href="/portfolio-details/"><img src="/assets/imgs/project/image-20.webp" alt="image" loading="lazy"></a>
                      </div>
                    </div>
                    <div class="content">
                      <h3 class="title"><a href="/portfolio-details/">Saudi Lime Green</a></h3>
