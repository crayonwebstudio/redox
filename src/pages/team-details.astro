---
import BaseLayout from '../layouts/BaseLayout.astro';

const props = {
  title: "Team Details | Woodwolf Digital",
  description: "Details of a Woodwolf Digital team member and their work.",
  path: "/team-details/",
  bodyClass: "body-wrapper body-page-inner font-heading-sequelsans-romanbody",
  ogImage: "/assets/imgs/team/team-14.webp",
  breadcrumbLabel: 'Team Details',
  variant: 'inner',
};
---
<BaseLayout {...props}>
<!-- side toggle end -->

  <!-- Header area start -->
  
  <!-- Header area end -->

  
  
    

      

        <!-- team details area start  -->
        <section class="team-details-area">
          <div class="container">
            <div class="team-details-area-inner section-spacing-top">
              <div class="section-content-wrapper fade-anim">
                <div class="team-thumb">
                  <img src="/assets/imgs/team/team-14.webp" alt="image">
                </div>
                <div class="section-content">
                  <div class="section-title-wrapper">
                    <div class="title-wrapper">
                      <h1 class="section-title font-sequelsans-romanbody">Jared
                        Silverman</h1>
                    </div>
                    <div class="subtitle-wrapper">
                      <span class="section-subtitle">Java Developer</span>
                    </div>
                  </div>
                  <div class="text-wrapper">
                    <p class="text">I’m leading experts in disciplines ranging from data science and neural networks
                      to low-level devices, software engineering, and architecture.</p>
                    <p class="text">By combining our strong experience in AI-enriched technology areas and product
                      development mindset, we provide unique smart products co-creation services enabling cities,
                      industries, and people to make their way into a new era of the digital efficiently and securely.
                    </p>
                  </div>
                  <div class="social-links">
                    <a href="#">Facebook</a>
                    <a href="#">Twitter</a>
                    <a href="#">Dribbble</a>
                    <a href="#">LinkedIn</a>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </section>
        <!-- team details area end  -->

      

      <!-- footer area start  -->
      
      <!-- footer area end  -->

    </div>
  </div>
</BaseLayout>
