---
import VariantLayout from '../layouts/VariantLayout.astro';
import headerHtml from '../data/variants/modern-agency-3-header.html?raw';
import sideInfoHtml from '../data/variants/modern-agency-3-sideinfo.html?raw';
import footerHtml from '../data/variants/modern-agency-3-footer.html?raw';

const props = {
  title: "Modern Agency 3 | Woodwolf Digital",
  description: "Explore Woodwolf Digital's modern agency 3 homepage: creative design, development and marketing services, portfolio work and team.",
  path: "/modern-agency-3/",
  bodyClass: "body-wrapper body-about-us",
  cssFiles: ["/assets/css/ad-style.css"],
  scriptFiles: ["/assets/vendor/jquery-3.7.1.min.js", "/assets/vendor/bootstrap.bundle.min.js", "/assets/vendor/jquery.magnific-popup.min.js", "/assets/vendor/gsap.min.js", "/assets/vendor/ScrollTrigger.min.js", "/assets/vendor/ScrollSmoother.min.js", "/assets/vendor/ScrollToPlugin.min.js", "/assets/vendor/SplitText.min.js", "/assets/vendor/TextPlugin.js", "/assets/vendor/customEase.js", "/assets/vendor/Flip.min.js", "/assets/vendor/jquery.meanmenu.min.js", "/assets/vendor/backToTop.js", "/assets/vendor/matter.js", "/assets/vendor/throwable.js", "/assets/ad-js/magiccursor.js", "/assets/vendor/waypoints.min.js", "/assets/ad-js/image-reveal-hover.js", "/assets/ad-js/main.js"],
  headerHtml,
  sideInfoHtml,
  footerHtml,
  noindex: true,
};
---
<VariantLayout {...props}>

    <!-- Header area end -->

    <!-- Header area end -->

    
    
        

            <main class="rr-bg-light">
                <!-- hero-area-7 area start  -->
