                        <a href="/portfolio-details/"><img src="/assets/imgs/project/image-69.webp" alt="image"></a>
                      </div>
                    </div>
                  </div>
                  <div class="work-box">
                    <div class="thumb fade-anim" data-cursor-text='<div class="content">
                      <h3 class="title"><a href="/portfolio-details/">Panda Automap</a></h3>
