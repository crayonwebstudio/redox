---
import VariantLayout from '../layouts/VariantLayout.astro';
import headerHtml from '../data/variants/modern-agency-header.html?raw';
import sideInfoHtml from '../data/variants/modern-agency-sideinfo.html?raw';
import footerHtml from '../data/variants/modern-agency-footer.html?raw';

const props = {
  title: "Modern Agency | Woodwolf Digital",
  description: "Explore Woodwolf Digital's modern agency homepage: creative design, development and marketing services, portfolio work and team.",
  path: "/modern-agency/",
  bodyClass: "body-wrapper body-modern-agency font-heading-tartuffotrial-thin",
  cssFiles: ["/assets/css/style.css"],
  scriptFiles: ["/assets/vendor/jquery-3.7.1.min.js", "/assets/vendor/bootstrap.bundle.min.js", "/assets/vendor/jquery.magnific-popup.min.js", "/assets/vendor/swiper-bundle.min.js", "/assets/vendor/gsap.min.js", "/assets/vendor/ScrollTrigger.min.js", "/assets/vendor/ScrollSmoother.min.js", "/assets/vendor/ScrollToPlugin.min.js", "/assets/vendor/SplitText.min.js", "/assets/vendor/TextPlugin.js", "/assets/vendor/customEase.js", "/assets/vendor/Flip.min.js", "/assets/vendor/jquery.meanmenu.min.js", "/assets/vendor/backToTop.js", "/assets/vendor/matter.js", "/assets/vendor/throwable.js", "/assets/js/magiccursor.js", "/assets/js/main.js"],
  headerHtml,
  sideInfoHtml,
  footerHtml,
  noindex: true,
};
---
<VariantLayout {...props}>

  <!-- Header area end -->

  
  
    

      

        <!-- hero area start -->
        <div class="hero-area-7">
          <div class="hero-area-7-inner">
            <div class="section-content">
              <div class="section-title-wrapper">
                <div class="container large">
                  <div class="title-wrapper">
                    <h1 class="section-title font-tartuffotrial-thin char-anim">We’re Woodwolf Digital, a creative
                      design agency based in
                      <span>Germany</span>
                    </h1>
                  </div>
                </div>
              </div>
              <div class="container large">
                <div class="text-wrapper fade-anim" data-delay="0.90">
                  <p class="text">We are a duo of design obsessed who strive to push the boundaries of what is possible.
                  </p>
                </div>
                <div class="btn-wrapper fade-anim">
                  <a href="/about/" class="rr-btn">
                    <span class="btn-wrap">
                      <span class="text-one">Learn more us</span>
                      <span class="text-two">Learn more us</span>
                    </span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- hero area end -->

        <!-- work area start  -->
        <section class="work-area-7">
