---
import BaseLayout from '../layouts/BaseLayout.astro';

const props = {
  title: "Woodwolf Digital | Creative Agency for Design, Development and Marketing",
  description: "Woodwolf Digital is a creative agency for design, development and marketing, working with global clients. Explore our services, portfolio, team and latest journals.",
  path: "/",
  bodyClass: "body-wrapper body-digital-agency font-heading-instrumentsans-medium",
  ogImage: "/assets/imgs/logo/logo.png",
  variant: 'home',
};
---
<BaseLayout {...props}>
<!-- side toggle end -->

  <!-- Header area start -->
  

  <!-- Header area end -->

  
  
    

      

        <!-- hero area start  -->
        <section class="hero-area">
          <div class="container large">
            <div class="hero-area-inner section-spacing-top">
