                <div class="award-wrapper fade-anim" data-delay="0.90" data-direction="left" data-ease="back.out(4)">
                  <div class="circle-text-wrapper">
                    <div class="circle-text">
                      <img src="/assets/imgs/shape/shape-3.webp" alt="image" class="text">
                      <img src="/assets/imgs/shape/shape-2.webp" alt="image" class="icon" loading="lazy">
                    </div>
                  </div>
                </div>
                <div class="section-header">
                  <div class="section-title-wrapper">
                    <div class="title-wrapper">
                      <h1 class="section-title font-instrumentsans-medium char-anim" data-delay="0.45">Let’s sharpen
                        your brand
                        with<span><img class="title-shape-1 fade-anim" src="/assets/imgs/shape/shape-1.webp" alt="image"
                            data-direction="right" data-delay="1.80" loading="lazy"></span>quality
                        work</h1>
                    </div>
                  </div>
                </div>
                <div class="section-content">
                  <div class="features-wrapper-box fade-anim" data-delay="0.75">
                    <div class="features-wrapper">
                      <div class="feature-box">
                        <div class="content">
                          <span class="number">98%</span>
                          <p class="text">Average clients satisfied
                            and repeating</p>
                        </div>
                      </div>
                      <div class="feature-box">
                        <div class="content">
                          <span class="number">120+</span>
                          <p class="text">Successfully projects done
                            in 24 countries</p>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="text-wrapper fade-anim" data-delay="0.75">
                    <p class="text">We’re a digital products design & development agency that works passionately
                      with the digital experiences.</p>
                  </div>
                </div>
              </div>
              <div class="big-text-wrapper">
                <h2 class="big-text">Woodwolf Digital
                </h2>
              </div>

            </div>
          </div>
        </section>
        <!-- hero area end  -->

        <!-- about area start  -->
        <section class="about-area ">
