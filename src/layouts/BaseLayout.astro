---
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  bodyClass?: string;
  ogImage?: string;
  noindex?: boolean;
  canonicalPath?: string;
  breadcrumbLabel?: string;
  headerHtml: string;
  footerHtml: string;
  offcanvasHtml?: string;
}
const { title, description, path, bodyClass, ogImage, noindex, canonicalPath, breadcrumbLabel, headerHtml, footerHtml, offcanvasHtml } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} path={path} ogImage={ogImage} noindex={noindex} canonicalPath={canonicalPath} breadcrumbLabel={breadcrumbLabel} />
    <link rel="icon" type="image/x-icon" href="/assets/imgs/logo/favicon.png" />
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/assets/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/assets/css/animate.min.css" />
    <link rel="stylesheet" href="/assets/css/redox-core.css" />
    <link rel="stylesheet" href="/assets/css/redox-spacing.css" />
    <link rel="stylesheet" href="/assets/css/redox-unit.css" />
    <link rel="stylesheet" href="/assets/css/redox-update.css" />
    <link rel="stylesheet" href="/assets/css/wp-compat.css" />
    <link rel="stylesheet" href="/assets/css/generated-layout.css" />
    <style>
      @keyframes preloader-hide { to { opacity: 0; visibility: hidden; } }
      #preloader { animation: preloader-hide 0s 6s forwards; }
    </style>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div id="preloader">
      <div id="container" class="container-preloader">
        <div class="animation-preloader"><div class="spinner"></div></div>
        <div class="loader-section section-left"></div>
        <div class="loader-section section-right"></div>
      </div>
    </div>
    <script is:inline>
      setTimeout(function () { var p = document.getElementById('preloader'); if (p) p.remove(); }, 1500);
      setTimeout(function () { var p = document.getElementById('preloader'); if (p) p.remove(); }, 5000);
    </script>
    <Fragment set:html={headerHtml} />
    <main id="main-content">
      <slot />
    </main>
    <Fragment set:html={footerHtml} />
    {offcanvasHtml && <Fragment set:html={offcanvasHtml} />}
    <div class="back-to-top-wrapper">
      <button id="back-to-top" type="button" class="back-to-top-btn" aria-label="Back to top">
        <span>Top</span>
      </button>
    </div>
    <script src="/assets/js/swiper-bundle.min.js" defer></script>
    <script src="/assets/js/site-wp.js" defer></script>
  </body>
</html>
